  <div class="tab-content" id="tab-contact"><label>البريد</label><input type="email" id="f_email"><label>البريد 2</label><input type="email" id="f_email2"><label>الهاتف</label><input type="tel" id="f_phone"><label>الهاتف 2</label><input type="tel" id="f_phone2"><label>واتساب</label><input type="tel" id="f_whatsapp"><label>تيليجرام</label><input type="text" id="f_telegram"><label>سيغنال</label><input type="tel" id="f_signal"></div>
  <div class="tab-content" id="tab-accounts"><label>فيسبوك</label><input type="url" id="f_facebook"><label>إنستغرام</label><input type="url" id="f_instagram"><label>تويتر</label><input type="url" id="f_twitter"><label>تيك توك</label><input type="url" id="f_tiktok"><label>يوتيوب</label><input type="url" id="f_youtube"><label>لينكد إن</label><input type="url" id="f_linkedin"><label>سناب شات</label><input type="text" id="f_snapchat"><label>أخرى</label><textarea id="f_other_accounts" rows="2"></textarea></div>
  <div class="tab-content" id="tab-location"><label>العنوان</label><input type="text" id="f_address"><label>العنوان السابق</label><input type="text" id="f_address2"><label>العمل</label><input type="text" id="f_workplace"><label>الدراسة</label><input type="text" id="f_school"><label>GPS</label><input type="text" id="f_gps"><label>ملاحظات</label><textarea id="f_location_notes" rows="2"></textarea></div>
