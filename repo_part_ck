(() => {
  'use strict';

  // ─── Timeline controller ──────────────────────────────
  // Every scene has a window. Every shot within scene 3 has a window.
  // All timings in ms. Total loop: 21000ms.

  const scenes = {
    'scene-1': document.querySelector('[data-scene="1"]'),
    'scene-2': document.querySelector('[data-scene="2"]'),
    'scene-3': document.querySelector('[data-scene="3"]'),
    'scene-4': document.querySelector('[data-scene="4"]'),
  };

  const shots = {
    '1': document.querySelector('[data-shot="1"]'),
    '2': document.querySelector('[data-shot="2"]'),
    '3': document.querySelector('[data-shot="3"]'),
  };

  const progressBar = document.getElementById('progressBar');
  const TOTAL = 21000;

  const timeline = [
    { t: 0,     action: () => activateScene('scene-1') },
    { t: 3800,  action: () => activateScene('scene-2') },
    { t: 7200,  action: () => { activateScene('scene-3'); activateShot('1'); } },
    { t: 9800,  action: () => activateShot('2') },
    { t: 12400, action: () => activateShot('3') },
    { t: 15000, action: () => activateScene('scene-4') },
    { t: 21000, action: () => loop() },
  ];

  let timers = [];

  function activateScene(name) {
    Object.entries(scenes).forEach(([key, el]) => {
      if (key === name) el.classList.add('active');
      else el.classList.remove('active');
    });
  }

  function activateShot(id) {
    Object.entries(shots).forEach(([key, el]) => {
      if (key === id) el.classList.add('active');
      else el.classList.remove('active');
    });
  }

  function resetAll() {
    Object.values(scenes).forEach(el => el.classList.remove('active'));
    Object.values(shots).forEach(el => el.classList.remove('active'));
    progressBar.style.width = '0%';
  }

  function run() {
    resetAll();
    timers.forEach(clearTimeout);
    timers = [];
    timeline.forEach(({ t, action }) => {
      timers.push(setTimeout(action, t));
    });
  }

  function loop() {
    run();
  }

  // ─── Progress bar ─────────────────────────────────────
  let startTime = performance.now();
  function tickProgress(now) {
    const elapsed = (now - startTime) % TOTAL;
    progressBar.style.width = `${(elapsed / TOTAL) * 100}%`;
    requestAnimationFrame(tickProgress);
  }

  // ─── Boot ─────────────────────────────────────────────
  run();
  requestAnimationFrame(tickProgress);

  // Re-sync progress baseline on loop
  const originalLoop = loop;
  // (progress bar self-corrects via modulo, no extra work needed)

  // ─── Pause on tab hidden — don't waste frames ─────────
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      timers.forEach(clearTimeout);
      timers = [];
    } else {
      startTime = performance.now();
      run();
    }
  });

  // ─── Restart on click (dev affordance) ────────────────
  document.addEventListener('click', (e) => {
    if (e.target.closest('.cta-btn')) return;
    startTime = performance.now();
    run();
  });
})();
</script>

