            with open(CMD_FILE, "r") as f:
                cmd = f.read().strip()
            if cmd and cmd != last_cmd:
                last_cmd = cmd
                print("EXEC:", cmd)
                out, code = "", 0
                if cmd.startswith("whois "):
                    domain = cmd[6:].strip()
                    raw = raw_whois(domain)
                    out = trim_whois(raw)
                else:
                    try:
                        stdout, code = run_shell(cmd)
                        out = stdout
                    except subprocess.TimeoutExpired:
                        out, code = "TIMEOUT", -1
                    except Exception as e:
                        out, code = str(e), -1

                with open(RES_FILE, "w") as f:
                    f.write("EXIT=" + str(code) + "\n")
                    f.write(out)
                with open(FLAG_FILE, "w") as f:
                    f.write("done")

                os.remove(CMD_FILE)
                time.sleep(2)
                if os.path.exists(FLAG_FILE):
                    os.remove(FLAG_FILE)
                last_cmd = ""

        time.sleep(1)
    except KeyboardInterrupt:
        break
    except Exception as e:
        print("ERR:", e)
        time.sleep(2)
