"""الذاكرة الجوهرية L2."""
import json
from pathlib import Path
from ..utils.io import read_text, write_text


class CoreMemory:
    MAX_SIZE = 5120

    def __init__(self, path="core_memory.json"):
        self.path = Path(path)
        self.data = {}
        self._load()

    def _load(self):
        if self.path.exists():
            self.data = json.loads(read_text(self.path))
        else:
            self.data = {"user": {}, "project": {}, "session": {}, "preferences": {}}

    def save(self):
        serialized = json.dumps(self.data, ensure_ascii=False, indent=2)
        if len(serialized.encode("utf-8")) > self.MAX_SIZE:
            raise ValueError(f"L2 > {self.MAX_SIZE} بايت")
        write_text(self.path, serialized)

    def get(self, key, default=None):
        parts = key.split(".")
        node = self.data
        for p in parts:
            if not isinstance(node, dict) or p not in node:
                return default
            node = node[p]
        return node

    def set(self, key, value):
        parts = key.split(".")
        node = self.data
        for p in parts[:-1]:
            node = node.setdefault(p, {})
        node[parts[-1]] = value
        self.save()

    def delete(self, key):
        parts = key.split(".")
        node = self.data
        for p in parts[:-1]:
            node = node.get(p, {})
        node.pop(parts[-1], None)
        self.save()

    def keys(self):
        out = []
        def walk(n, prefix=""):
            for k, v in n.items():
                full = f"{prefix}.{k}" if prefix else k
                if isinstance(v, dict):
                    walk(v, full)
                else:
                    out.append(full)
        walk(self.data)
        return out

    def as_context(self):
        lines = ["[CORE MEMORY]"]
        for k in self.keys():
            lines.append(f"{k} = {self.get(k)}")
        return "\n".join(lines)
