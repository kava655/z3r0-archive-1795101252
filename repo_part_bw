  else { const existing = cy.edges().filter(e => e.data('source') === from && e.data('target') === to); if (existing.length > 0) { setMsg('العلاقة موجودة'); return; } const id = 'r_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7); localData.relations.push({ id, from, target: to, type, note }); }
