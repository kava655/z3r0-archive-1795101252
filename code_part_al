#!/usr/bin/env python3
# database osint - Backend
import os, json, sqlite3, uuid, time
from flask import Flask, request, jsonify, send_from_directory, send_file
from werkzeug.utils import secure_filename

BASE = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.path.join(BASE, 'osint.db')
DATA_DIR = os.path.join(BASE, 'data')
STATIC_DIR = os.path.join(BASE, 'static')

app = Flask(__name__, static_folder=STATIC_DIR, static_url_path='')
app.config['MAX_CONTENT_LENGTH'] = 200 * 1024 * 1024  # 200 MB

def db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = db()
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS entities (
        id TEXT PRIMARY KEY,
        name TEXT,
        alias TEXT,
        type TEXT,
        gender TEXT,
        birthdate TEXT,
        nationality TEXT,
        status TEXT,
        email TEXT, email2 TEXT,
        phone TEXT, phone2 TEXT,
        whatsapp TEXT, telegram TEXT, signal TEXT,
        facebook TEXT, instagram TEXT, twitter TEXT,
        tiktok TEXT, youtube TEXT, linkedin TEXT,
        snapchat TEXT, other_accounts TEXT,
        address TEXT, address2 TEXT,
        workplace TEXT, school TEXT,
        gps TEXT, location_notes TEXT,
        videos TEXT, files TEXT,
        passwords TEXT, sensitive TEXT,
        notes TEXT, tags TEXT,
        avatar TEXT,
        images TEXT,
        created REAL,
        updated REAL
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS relations (
        id TEXT PRIMARY KEY,
        source TEXT,
        target TEXT,
        type TEXT,
        note TEXT,
        created REAL
    )''')
    c.execute('CREATE INDEX IF NOT EXISTS idx_rel_source ON relations(source)')
    c.execute('CREATE INDEX IF NOT EXISTS idx_rel_target ON relations(target)')
    c.execute('CREATE INDEX IF NOT EXISTS idx_ent_name ON entities(name)')
    conn.commit()
    conn.close()

# ====== STATIC ======
@app.route('/')
def index():
    return send_from_directory(STATIC_DIR, 'index.html')

@app.route('/data/<path:filepath>')
def serve_data(filepath):
    return send_from_directory(DATA_DIR, filepath)

# ====== ENTITIES ======
@app.route('/api/entities', methods=['GET'])
def list_entities():
    conn = db()
    rows = conn.execute('SELECT * FROM entities ORDER BY updated DESC').fetchall()
    conn.close()
    out = []
    for r in rows:
        d = dict(r)
        if d.get('images'):
            try: d['images'] = json.loads(d['images'])
            except: d['images'] = []
        else: d['images'] = []
        out.append(d)
    return jsonify(out)

@app.route('/api/entities/<eid>', methods=['GET'])
def get_entity(eid):
    conn = db()
    r = conn.execute('SELECT * FROM entities WHERE id=?', (eid,)).fetchone()
    conn.close()
    if not r: return jsonify({'error': 'not found'}), 404
    d = dict(r)
    if d.get('images'):
        try: d['images'] = json.loads(d['images'])
        except: d['images'] = []
    else: d['images'] = []
    return jsonify(d)

