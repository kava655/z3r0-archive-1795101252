# ====== UPLOAD ======
@app.route('/api/upload/<kind>', methods=['POST'])
def upload(kind):
    if kind not in ('avatars', 'images', 'videos', 'files'):
        return jsonify({'error': 'invalid kind'}), 400
    if 'file' not in request.files:
        return jsonify({'error': 'no file'}), 400
    f = request.files['file']
    if not f.filename:
        return jsonify({'error': 'empty filename'}), 400
    ext = os.path.splitext(f.filename)[1].lower()
    fname = uuid.uuid4().hex + ext
    folder = os.path.join(DATA_DIR, kind)
    os.makedirs(folder, exist_ok=True)
    f.save(os.path.join(folder, fname))
    return jsonify({'path': f'data/{kind}/{fname}', 'name': fname})

@app.route('/api/upload/delete', methods=['POST'])
def delete_upload():
    data = request.get_json(force=True)
    path = data.get('path', '')
    if path.startswith('data/'):
        full = os.path.join(BASE, path)
        if os.path.isfile(full):
            try: os.remove(full)
            except: pass
    return jsonify({'status': 'ok'})

