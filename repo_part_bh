        except: d['images'] = []
    else: d['images'] = []
    return jsonify(d)

@app.route('/api/entities', methods=['POST'])
def create_entity():
    data = request.get_json(force=True)
    eid = data.get('id') or ('e_' + uuid.uuid4().hex[:12])
    now = time.time()
    fields = ['name','alias','type','gender','birthdate','nationality','status',
              'email','email2','phone','phone2','whatsapp','telegram','signal',
              'facebook','instagram','twitter','tiktok','youtube','linkedin',
              'snapchat','other_accounts','address','address2','workplace','school',
              'gps','location_notes','videos','files','passwords','sensitive',
              'notes','tags','avatar']
    vals = [data.get(f, '') or '' for f in fields]
    images = data.get('images', [])
    if not isinstance(images, list): images = []
    images_json = json.dumps(images)
    conn = db()
    existing = conn.execute('SELECT id FROM entities WHERE id=?', (eid,)).fetchone()
    if existing:
        sets = ', '.join([f+'=?' for f in fields]) + ', images=?, updated=?'
        conn.execute(f'UPDATE entities SET {sets} WHERE id=?', vals + [images_json, now, eid])
    else:
        placeholders = ','.join(['?'] * (len(fields)+3))
        conn.execute(f'INSERT INTO entities (id, {",".join(fields)}, images, created, updated) VALUES ({placeholders})',
                     [eid] + vals + [images_json, now, now])
    conn.commit()
    conn.close()
    return jsonify({'id': eid, 'status': 'ok'})

@app.route('/api/entities/<eid>', methods=['DELETE'])
def delete_entity(eid):
    conn = db()
    # get files to delete
    r = conn.execute('SELECT avatar, images FROM entities WHERE id=?', (eid,)).fetchone()
    if r:
        files_to_del = []
        if r['avatar']:
            files_to_del.append(r['avatar'])
        if r['images']:
            try:
                for f in json.loads(r['images']):
                    files_to_del.append(f)
            except: pass
        for f in files_to_del:
            path = os.path.join(BASE, f.lstrip('/'))
            if os.path.isfile(path):
                try: os.remove(path)
                except: pass
    conn.execute('DELETE FROM entities WHERE id=?', (eid,))
    conn.execute('DELETE FROM relations WHERE source=? OR target=?', (eid, eid))
    conn.commit()
    conn.close()
    return jsonify({'status': 'ok'})

