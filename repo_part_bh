def stats():
    conn = db()
    ne = conn.execute('SELECT COUNT(*) FROM entities').fetchone()[0]
    nr = conn.execute('SELECT COUNT(*) FROM relations').fetchone()[0]
    conn.close()
    return jsonify({'entities': ne, 'relations': nr})

